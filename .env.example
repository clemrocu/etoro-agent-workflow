# Copy to .env locally. In production these live in the Mistral workspace secrets.
MISTRAL_API_KEY=

# eToro agent (choose the account segment: real | demo)
ETORO_ACCOUNT=real
# ETORO_TOKEN = the agent portfolio user token (visible ONCE at creation)
ETORO_TOKEN=
# Alternative key-pair auth (own account, not the agent portfolio)
ETORO_USER_KEY=
ETORO_API_KEY=

# Notifications
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh
